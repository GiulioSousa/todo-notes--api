# Modelo do /etc/todonotes/todonotes.env — SEM SEGREDO, versionado.
#
# O deploy/preparar-servidor.sh escreve o arquivo real no servidor, com root:root 600, e
# gera as três senhas ali mesmo: elas não passam pelo chat, pelo Git nem pela tela. Este
# modelo existe para quem quiser ler o que vai lá dentro sem abrir o arquivo real.
#
# Só existem estas variáveis — a lista acompanha o application.yml.

# Sem arquivo correspondente, de propósito: o perfil só desloca o padrão `local`, para o
# Spring não procurar o application-local.yml.
SPRING_PROFILES_ACTIVE=prod

# A 8080 é de outra aplicação no servidor. Conferir com `ss -tlnp` antes de escolher.
SERVER_PORT=8092
MANAGEMENT_PORT=8093

# As duas andam juntas, ou nenhuma: ver application.yml.
SERVER_ADDRESS=127.0.0.1
FORWARD_HEADERS_STRATEGY=FRAMEWORK

# O cluster do servidor, não a 5433 de desenvolvimento.
DB_URL=jdbc:postgresql://localhost:5432/todonotes_db
DB_USERNAME=todonotes_app
DB_PASSWORD=<gerada no servidor>
DB_MIGRACAO_USERNAME=todonotes_migracao
DB_MIGRACAO_PASSWORD=<gerada no servidor>

# Base64 de 48 bytes, o mínimo do HS384.
JWT_SECRET=<gerada no servidor>

# VAZIO, e a linha presente: frontend e API sob o mesmo domínio não passam por CORS.
# Apagar a linha faz o padrão http://localhost:4200 voltar em silêncio.
CORS_ORIGENS=
